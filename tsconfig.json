{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "src",
    "app",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "global.d.ts",
    ".expo/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/node_modules/*", "build"]
}
